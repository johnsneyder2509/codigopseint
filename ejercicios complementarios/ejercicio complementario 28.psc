//Como profesor de lectoescritura, quiero ingresar una letra para saber si es vocal o consonante
Proceso sin_titulo
	definir let Como Caracter;
	Escribir "que letra quiere saber";
	leer let;
	segun let Hacer
		"A":
			Escribir "es vocal";
		"E":
			Escribir "es vocal";
		"I":
			Escribir "es vocal";
	   "o":
			Escribir "es vocal";
		"U":
			Escribir "es vocal";
		De Otro Modo:
			Escribir "Es consonante";
	Fin Segun
FinProceso
