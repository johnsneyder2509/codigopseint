Algoritmo j
    Definir num Como Entero;
    Escribir "Ingresa un dígito del 0 al 9:";
    Leer num;
    Segun num Hacer
        0: Escribir "Cero";
        1: Escribir "Uno";
        2: Escribir "Dos";
        3: Escribir "Tres";
        4: Escribir "Cuatro";
        5: Escribir "Cinco";
        6: Escribir "Seis";
        7: Escribir "Siete";
        8: Escribir "Ocho";
        9: Escribir "Nueve";
        De Otro Modo: Escribir "Ingresa solo un dígito";
    FinSegun
FinAlgoritmo