Proceso sin_titulo
	Definir tiempo como real;
	definir tarifa como real;
	definir costo Como Real;
	
    Escribir "Ingrese el tiempo en horas:";
    Leer tiempo;
    Escribir "Ingrese la tarifa por hora:";
    Leer tarifa;
	
    costo <- tiempo * tarifa;
	
    Escribir "El costo total es: ", costo,;
FinProceso
