Proceso sin_titulo
	Definir ingresos como real;
	definir gastos Como Real; 
	definir ganancia Como Real;
	
    Escribir "Ingrese los ingresos:";
    Leer ingresos;
    Escribir "Ingrese los gastos:";
    Leer gastos;
	
    ganancia <- ingresos - gastos;
	
    Escribir "La ganancia neta es: ",ganancia,;
FinProceso
