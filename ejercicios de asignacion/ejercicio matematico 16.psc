Proceso sin_titulo
	//declarar variable
	Definir agua como real;
	definir luz como real;
    definir gas como real;
	definir total Como Real;
	// 2 tomar datos 
    Escribir "Ingrese el valor del servicio de agua:";
    Leer agua;
    Escribir "Ingrese el valor del servicio de luz:";
    Leer luz;
    Escribir "Ingrese el valor del servicio de gas:";
    Leer gas;
	
    total <- agua + luz + gas;
	
    Escribir "Total a pagar por los servicios: ", total;
FinProceso
